{
  "uid": "node-metrics",
  "title": "Ресурсы Docker",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "timezone": "browser",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Загрузка CPU",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "max": 100,
          "custom": {
            "fillOpacity": 18
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{job=\"system\",mode=\"idle\"}[30s])))",
          "legendFormat": "Все ядра",
          "format": "time_series",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "title": "Использованная память",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_MemTotal_bytes{job=\"system\"} - node_memory_MemAvailable_bytes{job=\"system\"}",
          "legendFormat": "Занято",
          "format": "time_series",
          "range": true
        },
        {
          "refId": "B",
          "expr": "node_memory_MemTotal_bytes{job=\"system\"}",
          "legendFormat": "Всего",
          "format": "time_series",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Сетевой трафик",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "description": "Трафик интерфейсов, доступных Node Exporter в сети Docker.",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(node_network_receive_bytes_total{job=\"system\",device!=\"lo\"}[30s]))",
          "legendFormat": "Приём",
          "format": "time_series",
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum(rate(node_network_transmit_bytes_total{job=\"system\",device!=\"lo\"}[30s]))",
          "legendFormat": "Передача",
          "format": "time_series",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "title": "Чтение и запись дисков",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_disk_read_bytes_total{job=\"system\",device!~\"loop.*|ram.*\"}[30s])",
          "legendFormat": "Чтение {{device}}",
          "format": "time_series",
          "range": true
        },
        {
          "refId": "B",
          "expr": "rate(node_disk_written_bytes_total{job=\"system\",device!~\"loop.*|ram.*\"}[30s])",
          "legendFormat": "Запись {{device}}",
          "format": "time_series",
          "range": true
        }
      ]
    }
  ]
}
