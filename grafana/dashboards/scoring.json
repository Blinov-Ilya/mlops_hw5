{
  "uid": "scoring",
  "title": "Запись в PostgreSQL",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "timezone": "browser",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Скорость записи",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(scorings_total{job=\"writer\"}[15s]))",
          "legendFormat": "Строк/с",
          "format": "time_series",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "title": "Среднее время записи",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(scoring_db_write_seconds_sum{job=\"writer\"}[30s])) / sum(rate(scoring_db_write_seconds_count{job=\"writer\"}[30s]))",
          "legendFormat": "Запись с commit",
          "format": "time_series",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Скоры в PostgreSQL",
      "type": "heatmap",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "description": "Количество транзакций по диапазонам скора за последние 15 секунд.",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 17,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "calculate": false,
        "color": {
          "scheme": "Greens",
          "mode": "scheme",
          "scale": "linear"
        },
        "yAxis": {
          "min": 0,
          "max": 1,
          "decimals": 2
        },
        "filterValues": {
          "le": 0
        },
        "tooltip": {
          "show": true,
          "yHistogram": false
        },
        "legend": {
          "show": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (le) (increase(scoring_fraud_score_bucket{job=\"writer\"}[15s]))",
          "legendFormat": "{{le}}",
          "format": "heatmap",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "title": "Всего записано",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "x": 17,
        "y": 8,
        "w": 7,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(scorings_total{job=\"writer\"})",
          "legendFormat": "",
          "format": "time_series",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "title": "Записано с флагом фрода",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "x": 17,
        "y": 13,
        "w": 7,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(fraud_detected_total{job=\"writer\"})",
          "legendFormat": "",
          "format": "time_series",
          "range": false,
          "instant": true
        }
      ]
    }
  ]
}
